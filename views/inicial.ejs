<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Painel Principal</title>
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <div class="container painel">
    <div class="info-topo">
      <h2>Sistema de Cadastro de Pessoas</h2>
      <hr>
      <h3>Usuário: <strong><%= usuario.login %></strong></h3>
    </div>

    <div class="grupo-botoes">
      <a href="/cadastro" class="btn">📝 Cadastrar Novo</a>
      <a href="/busca" class="btn">🔍 Buscar Pessoas</a>
      <a href="/sair" class="btn btn-vermelho">🚪 Sair do Sistema</a>
    </div>
  </div>

  <div class="data-hora-rodape" id="data-hora"></div>

<script src="/script.js"></script>
<script>
function atualizarHora(){
  const agora = new Date();
  const data = agora.toLocaleDateString('pt-BR');
  const hora = agora.toLocaleTimeString('pt-BR');
  document.getElementById('data-hora').innerText = `${data} ${hora}`;
}
atualizarHora();
setInterval(atualizarHora, 1000);
</script>
</body>
</html>