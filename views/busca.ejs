<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Busca de Pessoas</title>
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <div class="container caixa-login">
    <h2>Busca de Pessoas</h2>

    <div class="grupo" style="position:relative; margin-bottom:45px;">
      <label>Digite o nome ou parte do nome:</label>
      <input type="text" id="campoBusca" placeholder="Ex: Silva" autocomplete="off" style="margin-bottom:0; border-bottom-left-radius:0; border-bottom-right-radius:0;">

      <!-- ✅ TOTALMENTE ENCOSTADO NO CAMPO -->
      <div id="listaResultados" style="display:none; position:absolute; top:100%; left:0; right:0; margin:0; background:#fff; border:1px solid #ccc; border-top:none; border-radius:0 0 4px 4px; box-shadow:0 4px 8px rgba(0,0,0,0.15); z-index:999; max-height:250px; overflow-y:auto;">
        <div class="item-busca">Comece a digitar para ver os resultados...</div>
      </div>
    </div>

      <a href="/inicial" class="btn">Voltar</a>
      <a href="/sair" class="btn btn-sair">Sair</a>
    </div>
  </div>

<script src="/script.js"></script>
<script>
let timer;
const lista = document.getElementById('listaResultados');
document.getElementById('campoBusca').addEventListener('input', e => {
  clearTimeout(timer);
  const termo = e.target.value.trim();

  if (!termo) {
    lista.style.display = 'none';
    lista.innerHTML = '<div class="item-busca">Comece a digitar para ver os resultados...</div>';
    return;
  }

  lista.style.display = 'block';

  timer = setTimeout(() => {
    fetch(`/buscar-nomes?nome=${encodeURIComponent(termo)}`)
      .then(res => res.json())
      .then(dados => {
        if (dados.length === 0) {
          lista.innerHTML = '<div class="item-busca">Nenhum cadastro encontrado</div>';
          return;
        }
        lista.innerHTML = '';
        dados.forEach(p => {
          const div = document.createElement('div');
          div.className = 'item-busca';
          div.textContent = p.nome;
          div.onclick = () => window.location = `/ver/${p.id}`;
          lista.appendChild(div);
        });
      });
  }, 300);
});
</script>
</body>
</html>
