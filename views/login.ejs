<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Acesso ao Sistema</title>
  <link rel="stylesheet" href="/estilo.css">
</head>
<body class="tela-login">
  <div class="caixa-login">
    <h2>Sistema de Cadastro de Pessoas</h2>

    <% if(typeof erro !== 'undefined' && erro) { %>
      <div class="erro"><%= erro %></div>
    <% } %>

    <form method="post" action="/logar">
      <div class="grupo">
        <label>Usuário:</label>
        <input type="text" name="login" required autocomplete="username">
      </div>
      <div class="grupo">
        <label>Senha:</label>
        <input type="password" name="senha" required autocomplete="current-password">
      </div>
      <button type="submit">Entrar</button>
    </form>

    <!-- ✅ BOTÃO CADASTRAR NOVO USUÁRIO -->
    <a href="/cadastrar-usuario" class="botao-cadastrar">Cadastrar Novo Usuário</a>
  </div>
</body>
</html>